# The CLI reads process environment. The default local Compose startup needs no .env.
# These optional development settings override defaults when explicitly exported.
INKRAG_MODE=development
INKRAG_CAPABILITIES=combined
INKRAG_LEXICAL_PROFILE=legacy
INKRAG_VISION_PROVIDER=disabled
# For the Python SDK example, set the key in your process or secret manager.
SILICONFLOW_API_KEY=
